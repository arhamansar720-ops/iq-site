# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). The anon key is safe
# to use here — it's meant to be public, protected by Row Level Security.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Project Settings -> API -> service_role). This bypasses
# Row Level Security entirely — never prefix it with NEXT_PUBLIC_, never put
# it in client code. Only used server-side by the Stripe webhook.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe secret key (Developers -> API keys). Server-only, never NEXT_PUBLIC_.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (Developers -> Webhooks -> your endpoint, or
# printed by `stripe listen` when testing locally). Server-only.
STRIPE_WEBHOOK_SECRET=

# Price IDs (price_...) for the two paid plans, created in the Stripe
# dashboard under Products.
STRIPE_PRICE_PLUS=
STRIPE_PRICE_ONE=

# Used to build Stripe Checkout's success/cancel redirect URLs when running
# locally or if the request has no Origin header. In production this should
# be the real deployed domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
